# Environment variables for Planora AI
# Copy to .env and fill in values

# SQLite database — relative to project root
DATABASE_URL="file:./prisma/planora.db"

# Optional: Gemini API key for AI-powered planning (omit for demo mode)
# GEMINI_API_KEY=your-key-here

# Optional: Gemini model ID (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# App origin for CSRF protection
APP_ORIGIN=http://localhost:3000

